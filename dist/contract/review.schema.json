{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "implementationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "contractHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "approved",
        "changes-requested"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "testIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
      },
      "minItems": 0,
      "maxItems": 200,
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "minItems": 0,
      "maxItems": 200,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "implementationId",
    "contractHash",
    "decision",
    "summary",
    "testIds",
    "findings"
  ],
  "additionalProperties": false
}
