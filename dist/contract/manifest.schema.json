{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          },
          "featureId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.@/-]+$"
            },
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
            },
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          },
          "creators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "github": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
                },
                "declarationPath": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.@/-]+$"
                }
              },
              "required": [
                "github",
                "declarationPath"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true
          },
          "integration": {
            "type": "object",
            "properties": {
              "documentation": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.@/-]+$"
              },
              "appShells": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                },
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true
              },
              "entryPoints": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_.@/-]+$"
                },
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "documentation",
              "appShells",
              "entryPoints",
              "license"
            ],
            "additionalProperties": false
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                },
                "level": {
                  "enum": [
                    "unit",
                    "integration",
                    "ui",
                    "live",
                    "security"
                  ]
                },
                "workflowPath": {
                  "type": "string",
                  "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"
                },
                "jobName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "platformIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
                  },
                  "minItems": 1,
                  "maxItems": 200,
                  "uniqueItems": true
                },
                "protocols": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
                  },
                  "minItems": 0,
                  "maxItems": 200,
                  "uniqueItems": true
                },
                "assertions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "id",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 200,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "level",
                "workflowPath",
                "jobName",
                "command",
                "platformIds",
                "protocols",
                "assertions"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 200,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "featureId",
          "title",
          "paths",
          "platforms",
          "dependencies",
          "creators",
          "integration",
          "tests"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "implementations"
  ],
  "additionalProperties": false
}
